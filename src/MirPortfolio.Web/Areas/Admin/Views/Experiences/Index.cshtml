@model IReadOnlyList<Experience>

<div class="admin-card">
    <div class="admin-card__header">
        <h2 class="admin-card__title">Work &amp; education</h2>
        <a class="btn btn-sm btn-brand" asp-area="Admin" asp-controller="Experiences" asp-action="Create">
            New experience
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="admin-empty">
            <h2>No experience entries yet</h2>
            <p class="mb-3">Add work history and education to build the public timeline.</p>
            <a class="btn btn-brand" asp-area="Admin" asp-controller="Experiences" asp-action="Create">
                Create an entry
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Role</th>
                        <th scope="col">Organization</th>
                        <th scope="col">Type</th>
                        <th scope="col">Dates</th>
                        <th scope="col">Order</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var experience in Model)
                    {
                        <tr>
                            <td>
                                <span class="admin-table__primary">@experience.Title</span>
                                @if (!string.IsNullOrWhiteSpace(experience.Location))
                                {
                                    <span class="admin-table__muted">@experience.Location</span>
                                }
                            </td>
                            <td>@experience.Organization</td>
                            <td><span class="admin-badge">@experience.Type</span></td>
                            <td>
                                @experience.StartDate.ToString("MMM yyyy") &ndash;
                                @(experience.EndDate?.ToString("MMM yyyy") ?? "Present")
                            </td>
                            <td>@experience.DisplayOrder</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn btn-sm btn-outline-brand" asp-area="Admin"
                                       asp-controller="Experiences" asp-action="Edit" asp-route-id="@experience.Id">
                                        Edit
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-area="Admin"
                                       asp-controller="Experiences" asp-action="Delete" asp-route-id="@experience.Id">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
