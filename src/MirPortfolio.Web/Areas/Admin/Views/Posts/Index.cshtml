@model IReadOnlyList<BlogPost>

<div class="admin-card">
    <div class="admin-card__header">
        <h2 class="admin-card__title">All posts</h2>
        <a class="btn btn-sm btn-brand" asp-area="Admin" asp-controller="Posts" asp-action="Create">
            New post
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="admin-empty">
            <h2>No posts yet</h2>
            <p class="mb-3">Create your first Markdown post to start the public blog.</p>
            <a class="btn btn-brand" asp-area="Admin" asp-controller="Posts" asp-action="Create">
                Create a post
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Post</th>
                        <th scope="col">Status</th>
                        <th scope="col">Published</th>
                        <th scope="col">Updated</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td>
                                <span class="admin-table__primary">@post.Title</span>
                                <span class="admin-table__muted">/blog/@post.Slug</span>
                            </td>
                            <td>
                                @if (post.IsPublished)
                                {
                                    <span class="admin-badge admin-badge--on">Published</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge--muted">Draft</span>
                                }
                            </td>
                            <td>@(post.PublishedAt?.ToString("MMM d, yyyy") ?? "—")</td>
                            <td>@post.UpdatedAt.ToString("MMM d, yyyy")</td>
                            <td>
                                <div class="admin-actions">
                                    @if (post.IsPublished)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-area=""
                                           asp-controller="Blog" asp-action="Details"
                                           asp-route-slug="@post.Slug"
                                           target="_blank" rel="noopener noreferrer">
                                            View
                                        </a>
                                    }
                                    <a class="btn btn-sm btn-outline-brand" asp-area="Admin"
                                       asp-controller="Posts" asp-action="Edit" asp-route-id="@post.Id">
                                        Edit
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-area="Admin"
                                       asp-controller="Posts" asp-action="Delete" asp-route-id="@post.Id">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
