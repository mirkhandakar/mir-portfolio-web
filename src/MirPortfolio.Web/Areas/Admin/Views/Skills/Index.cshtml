@model IReadOnlyList<Skill>

<div class="admin-card">
    <div class="admin-card__header">
        <h2 class="admin-card__title">All skills</h2>
        <a class="btn btn-sm btn-brand" asp-area="Admin" asp-controller="Skills" asp-action="Create">
            New skill
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="admin-empty">
            <h2>No skills yet</h2>
            <p class="mb-3">Add the tools and technologies you want to highlight.</p>
            <a class="btn btn-brand" asp-area="Admin" asp-controller="Skills" asp-action="Create">
                Create a skill
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Skill</th>
                        <th scope="col">Category</th>
                        <th scope="col">Proficiency</th>
                        <th scope="col">Order</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skill in Model)
                    {
                        <tr>
                            <td class="admin-table__primary">@skill.Name</td>
                            <td>@skill.Category</td>
                            <td>
                                @if (skill.Proficiency.HasValue)
                                {
                                    <span>@skill.Proficiency / 5</span>
                                }
                                else
                                {
                                    <span class="admin-table__muted">Not set</span>
                                }
                            </td>
                            <td>@skill.DisplayOrder</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn btn-sm btn-outline-brand" asp-area="Admin"
                                       asp-controller="Skills" asp-action="Edit" asp-route-id="@skill.Id">
                                        Edit
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-area="Admin"
                                       asp-controller="Skills" asp-action="Delete" asp-route-id="@skill.Id">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
