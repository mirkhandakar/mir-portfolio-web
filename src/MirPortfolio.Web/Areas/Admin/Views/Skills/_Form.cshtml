@model SkillFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="admin-form__grid">
    <div>
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" placeholder="Languages, Frameworks, Tools" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Proficiency" class="form-label"></label>
        <select asp-for="Proficiency" class="form-select">
            <option value="">Not set</option>
            @for (var level = 1; level <= 5; level++)
            {
                <option value="@level">@level</option>
            }
        </select>
        <span class="admin-form__hint">Optional. 1 is familiar, 5 is expert.</span>
        <span asp-validation-for="Proficiency" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
        <span class="admin-form__hint">Lower numbers appear first within a category.</span>
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
    </div>
</div>
