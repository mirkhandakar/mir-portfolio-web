@model IReadOnlyList<Project>

<section class="page-header">
    <div class="container">
        <p class="eyebrow">Portfolio</p>
        <h1 class="section-title">Projects</h1>
        <p class="lead-copy">
            A selection of software projects I have designed and built, with the technologies and decisions behind each one.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        @if (Model.Count == 0)
        {
            <p class="empty-state">Projects will appear here once they are added in the admin area.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var project in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <partial name="_ProjectCard" model="project" />
                    </div>
                }
            </div>
        }
    </div>
</section>
