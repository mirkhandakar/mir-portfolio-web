@using MirPortfolio.Web.Services
@inject IPortfolioService PortfolioService
@{
    var siteProfile = await PortfolioService.GetProfileAsync();
    var pageTitle = ViewData["Title"]?.ToString();
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? siteProfile.FullName
        : $"{pageTitle} — {siteProfile.FullName}";
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? siteProfile.Headline;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string NavClass(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "nav-link nav-link--active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="theme-color" content="#f8fafc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@documentTitle" />
    <meta property="og:description" content="@metaDescription" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MirPortfolio.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand site-brand" asp-controller="Home" asp-action="Index">@siteProfile.FullName</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Home", "About")" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Projects", "Index")" asp-controller="Projects" asp-action="Index">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Contact", "Index")" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main" id="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4 align-items-center">
                <div class="col-md-6">
                    <p class="footer-brand mb-1">@siteProfile.FullName</p>
                    <p class="footer-muted mb-0">@siteProfile.Headline</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="footer-links">
                        @if (!string.IsNullOrWhiteSpace(siteProfile.GitHubUrl))
                        {
                            <a href="@siteProfile.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(siteProfile.LinkedInUrl))
                        {
                            <a href="@siteProfile.LinkedInUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        }
                        <a href="mailto:@siteProfile.Email">Email</a>
                        <a asp-controller="Contact" asp-action="Index">Contact</a>
                        @if (!string.IsNullOrWhiteSpace(siteProfile.ResumePath))
                        {
                            <a asp-controller="Resume" asp-action="Download">Resume</a>
                        }
                        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                    <p class="footer-muted small mb-0 mt-2">&copy; @DateTime.UtcNow.Year @siteProfile.FullName</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
