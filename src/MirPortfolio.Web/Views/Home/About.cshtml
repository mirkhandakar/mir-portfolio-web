@model AboutViewModel

<section class="page-header">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <p class="eyebrow">About me</p>
                <h1 class="hero-title">@Model.Profile.FullName</h1>
                <p class="hero-headline">@Model.Profile.Headline</p>
                <p class="lead-copy">@Model.Profile.Bio</p>
                <div class="hero-actions">
                    <a class="btn btn-brand" href="mailto:@Model.Profile.Email">Get in touch</a>
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.ResumePath))
                    {
                        <a class="btn btn-outline-brand" asp-controller="Resume" asp-action="Download">Download resume</a>
                    }
                </div>
                <div class="hero-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.Location))
                    {
                        <span>@Model.Profile.Location</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.GitHubUrl))
                    {
                        <a href="@Model.Profile.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.LinkedInUrl))
                    {
                        <a href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                    }
                </div>
            </div>
            <div class="col-lg-4 d-flex justify-content-lg-end">
                <partial name="_ProfilePortrait" model="Model.Profile" />
            </div>
        </div>
    </div>
</section>

<section class="section section--muted" id="skills">
    <div class="container">
        <div class="section-header">
            <div>
                <p class="eyebrow">Toolkit</p>
                <h2 class="section-title">Skills &amp; tools</h2>
            </div>
        </div>

        @if (Model.SkillGroups.Count == 0)
        {
            <p class="empty-state">Skills will appear here once they are added in the admin area.</p>
        }
        else
        {
            <div class="skill-grid">
                @foreach (var group in Model.SkillGroups)
                {
                    <div class="skill-panel">
                        <h3 class="skill-group__title">@group.Category</h3>
                        <ul class="skill-list">
                            @foreach (var skill in group.Skills)
                            {
                                <li class="skill-list__item">
                                    <span>@skill.Name</span>
                                    @if (skill.Proficiency is int level)
                                    {
                                        <span class="skill-level" title="Proficiency: @level out of 5">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <span class="skill-dot @(i <= level ? "is-filled" : string.Empty)"></span>
                                            }
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="section" id="experience">
    <div class="container">
        <div class="section-header">
            <div>
                <p class="eyebrow">Background</p>
                <h2 class="section-title">Experience &amp; education</h2>
            </div>
        </div>

        @if (Model.Experiences.Count == 0)
        {
            <p class="empty-state">Experience entries will appear here once they are added.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var experience in Model.Experiences)
                {
                    <partial name="_ExperienceItem" model="experience" />
                }
            </ul>
        }
    </div>
</section>

<section class="section section--accent">
    <div class="container">
        <div class="contact-card">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <p class="eyebrow">Contact</p>
                    <h2 class="section-title mb-3">Interested in working together?</h2>
                    <p class="lead-copy mb-0">Send a message and I'll get back to you as soon as I can.</p>
                </div>
                <div class="col-lg-4">
                    <div class="contact-actions">
                        <a class="btn btn-brand" asp-controller="Contact" asp-action="Index">Send a message</a>
                        <a class="btn btn-outline-brand" href="mailto:@Model.Profile.Email">Email me</a>
                        @if (!string.IsNullOrWhiteSpace(Model.Profile.ResumePath))
                        {
                            <a class="btn btn-outline-brand" asp-controller="Resume" asp-action="Download">Resume</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
